{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node_modules/.bin/tsx scripts/stryker-runner.ts"
  },
  "mutate": [
    "src/domain/article.ts",
    "src/domain/settings.ts",
    "src/domain/writing-skills.ts",
    "src/domain/text-diff.ts",
    "src/domain/urls.ts",
    "src/domain/images.ts",
    "src/domain/library-backup.ts",
    "src/domain/library-search.ts",
    "src/domain/base64.ts",
    "src/application/document-store.ts"
  ],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "timeoutFactor": 2,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 55
  }
}
