{
  "name": "dsh-markdown-studio",
  "version": "0.1.11",
  "description": "Local-first Markdown writing and WeChat Official Account typesetting studio for DeepSeek Harness with 8 editorial themes, named custom CSS themes, one-click inline-styled HTML copy, MathJax/Mermaid, and custom SKILL.md writing skills with inline diff.",
  "license": "MIT",
  "author": "Geekhyt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geekhyt/dsh-markdown-studio.git"
  },
  "homepage": "https://github.com/Geekhyt/dsh-markdown-studio#readme",
  "bugs": {
    "url": "https://github.com/Geekhyt/dsh-markdown-studio/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "dist/client.studio.js",
    "dist/mermaid.js",
    "dist/math.js",
    "cordis.patch.yml",
    "assets/icon.svg",
    "assets/screenshots/hero-studio-split.png",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "!docs/README.md",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.txt",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "markdown",
    "markdown-studio",
    "wechat",
    "typesetting",
    "editor",
    "wechat-official-account",
    "themes",
    "custom-css",
    "writing-skills",
    "local-first"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "dsh": ">=0.2.1-0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:gallery": "tsx scripts/build-gallery.ts",
    "prepack": "npm run build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:host-api": "node scripts/check-host-api.mjs",
    "test": "npm run typecheck && npm run build && tsx test/engine.test.ts && tsx test/domain.test.ts && tsx test/writing-skills.test.ts && tsx test/document-store.test.ts && tsx test/library-backup.test.ts && tsx test/schema.test.ts && tsx test/storage-migration.test.ts && tsx test/data-integrity.test.ts && tsx test/file-session.test.ts && tsx test/application-actions.test.ts && tsx test/custom-css.test.ts && tsx test/library-archive.test.ts && tsx test/library-search.test.ts && tsx test/encode.test.ts && tsx test/themes.test.ts && tsx test/theme-system.test.ts && tsx test/wechat-html.test.ts && tsx test/dom.test.ts && tsx test/copy-spec.test.ts && tsx test/error-boundary.test.ts && tsx test/dsh-primitives.test.ts && tsx test/client.test.ts && tsx test/architecture.test.ts && tsx test/coverage-model.test.ts && tsx test/shortcuts-regression.test.ts && tsx test/app-dom.test.ts && tsx test/zip.test.ts && tsx test/zip-stream.test.ts && tsx test/host-client.test.ts && tsx test/host.test.ts && tsx test/oss-readiness.test.ts",
    "test:browser": "npm run build && tsx test/browser-smoke.ts",
    "test:coverage": "npm test && tsx scripts/build-test.ts && tsx test/browser-smoke.ts --coverage",
    "coverage": "c8 --reporter=json npm run test:coverage && tsx scripts/coverage-check.ts",
    "quality": "npm run coverage && tsx scripts/crap.ts && npm run budget",
    "budget": "tsx scripts/bundle-budget.ts",
    "licenses": "tsx scripts/third-party-licenses.ts",
    "licenses:check": "tsx scripts/third-party-licenses.ts --check",
    "mutation": "tsx scripts/mutation-smoke.ts",
    "mutation:stryker": "stryker run",
    "test:dsh": "tsx test/dsh-e2e.ts",
    "test:migrations": "tsx test/storage-migration.test.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "overrides": {
    "dompurify": "^3.4.18",
    "glob": "^14.0.6",
    "katex": "^0.19.1",
    "minimatch": "^11.0.8",
    "qs": "^6.17.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.1-0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@stryker-mutator/core": "^9.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/wicg-file-system-access": "^2023.10.7",
    "axe-core": "^4.14.0",
    "c8": "^10.1.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "mathjax-full": "^3.2.2",
    "mermaid": "^11.17.2",
    "mp-darkmode": "^1.2.3-alpha.6",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
